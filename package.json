{
  "name": "marmitop",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "turbo": "^2.10.7"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
