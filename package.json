{
  "name": "marmitop",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "lint": "turbo run lint",
    "dev:stack": "bun scripts/local-dev.ts up",
    "dev:stack:down": "bun scripts/local-dev.ts down",
    "db:reset": "bun scripts/local-dev.ts reset",
    "db:test": "bun scripts/test-db.ts",
    "seed:generate": "bun scripts/dev-seed/generate.ts",
    "seed:verify": "bun scripts/dev-seed/verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "turbo": "^2.10.7"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
