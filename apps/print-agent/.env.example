# Names only (11.operations.md "Order ticket printer"). Copy to .env and fill in.
# The API base URL, without /v1.
MT_API_URL=
# A restaurant API key (mtk_live_… or mtk_test_…). Never logged (NFR-064).
MT_API_KEY=
# The CUPS queue name from `lpstat -p`, for example Elgin_i8.
MT_PRINTER=
# Optional: poll interval in ms (default 3000) and paper width in columns (default 48).
MT_PRINT_POLL_MS=
MT_PRINT_COLUMNS=
MT_LOG_LEVEL=
